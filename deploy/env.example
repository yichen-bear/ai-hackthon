# EC2 後端環境變數範本
# 複製為 backend/.env 並填入實際值

# RDS PostgreSQL 連線字串
DATABASE_URL="postgresql://postgres:你的密碼@你的rds-endpoint.us-west-2.rds.amazonaws.com:5432/aihackthon?sslmode=require"

# 應用設定
NODE_ENV=production
PORT=3001

# JWT 密鑰（自行生成，保持原有的）
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Groq API（AI 聊天）
GROQ_API_KEY=你的groq_api_key

# AWS SageMaker（語音辨識）
SAGEMAKER_ENDPOINT_NAME=breeze-asr-26-realtime
AWS_DEFAULT_REGION=us-west-2
# AWS_ACCESS_KEY_ID 和 AWS_SECRET_ACCESS_KEY 建議用 IAM Role 而非寫死

# 前端 URL（CORS 白名單用）
FRONTEND_URL=https://main.你的amplify-app-id.amplifyapp.com

# 前端 API Base（供參考，實際寫在前端 .env）
# NUXT_PUBLIC_API_BASE=https://你的domain
