model CommunityGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(50)
  type        String   @db.VarChar(20)  // interest, course
  icon        String   @db.VarChar(10)
  tags        String[] @default([])
  description String?  @db.VarChar(200)
  maxMembers  Int      @default(50) @map("max_members")
  activityDate     String?  @map("activity_date") @db.VarChar(50)
  activityTime     String?  @map("activity_time") @db.VarChar(50)
  activityLocation String?  @map("activity_location") @db.VarChar(100)
  creatorId   String   @map("creator_id") @db.Uuid
  creatorName String   @map("creator_name") @db.VarChar(50)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  creTime     DateTime @default(now()) @map("cre_time") @db.Timestamptz(6)
  updTime     DateTime @default(now()) @updatedAt @map("upd_time") @db.Timestamptz(6)

  members     GroupMember[]
  messages    ChatMessage[]

  @@map("community_group")
}

model GroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  userName String   @map("user_name") @db.VarChar(50)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  group    CommunityGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, userId])
  @@map("group_member")
}

model PickupReservation {
  id             String            @id @default(uuid()) @db.Uuid
  listingId      String            @map("listing_id") @db.Uuid
  buyerId        String            @map("buyer_id") @db.Uuid
  buyerName      String            @map("buyer_name") @db.VarChar(50)
  buyerPhone     String?           @map("buyer_phone") @db.VarChar(20)
  sellerId       String            @map("seller_id") @db.Uuid
  sellerName     String            @map("seller_name") @db.VarChar(50)
  pickupStore    String            @map("pickup_store") @db.VarChar(50)
  pickupMethod   String            @map("pickup_method") @db.VarChar(20)
  status         String            @default("PENDING_SELLER_APPROVAL") @db.VarChar(30)
  scheduledAt    DateTime?         @map("scheduled_at") @db.Timestamptz(6)
  creTime        DateTime          @default(now()) @map("cre_time") @db.Timestamptz(6)
  updTime        DateTime          @default(now()) @updatedAt @map("upd_time") @db.Timestamptz(6)
  pickupDeadline DateTime?         @map("pickup_deadline") @db.Timestamptz(6)
  storedAt       DateTime?         @map("stored_at") @db.Timestamptz(6)
  listing        SecondhandListing @relation(fields: [listingId], references: [id])

  @@map("pickup_reservation")
}




