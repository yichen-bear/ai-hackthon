# ============================================================
# Backend 環境變數範例檔
# 複製此檔案為 .env 並填入實際值，切勿將 .env 提交到版本控制
# ============================================================

# --- 資料庫連線 ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- 認證 / 加密 ---
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# --- Groq AI 聊天表單助理設定 ---
# Groq API 金鑰（必填，可於 https://console.groq.com 取得）
GROQ_API_KEY=your_groq_api_key_here

# 快速回應模型（選填，未設定時預設為 llama-3.1-8b-instant）
GROQ_MODEL_FAST=llama-3.1-8b-instant

# 高品質/智慧模型（選填，未設定時預設為 llama-3.3-70b-versatile）
GROQ_MODEL_SMART=llama-3.3-70b-versatile

# AI 聊天速率限制時間窗（秒，選填，程式碼未設定時會使用內建預設值）
AI_CHAT_RATE_WINDOW_SECONDS=

# AI 聊天速率限制視窗內最大呼叫次數（選填，程式碼未設定時會使用內建預設值）
AI_CHAT_RATE_MAX_CALLS=

# AI 表單填寫建議信心分數門檻（0~1 之間，選填，程式碼未設定時會使用內建預設值）
AI_CHAT_CONFIDENCE_THRESHOLD=

# 未指定服務時，AI 聊天使用的預設服務 ID（選填，程式碼未設定時會使用內建預設值）
AI_CHAT_DEFAULT_SERVICE_ID=

# AI 聊天所屬平台代碼（選填，程式碼未設定時會使用內建預設值）
AI_CHAT_PLATFORM_CODE=
